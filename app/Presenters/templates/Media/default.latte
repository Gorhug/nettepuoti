{block content}
<h1 n:block=title class="text-2xl">{_g.media.galleryTitle}</h1>
<a n:href="upload" class="btn btn-primary my-8" >{_g.link.mediaUpload}</a>
<section id="instructions" class="prose">{block|parsedown}{_g.media.defaultInstructions}{/block}</section>
{var $alt_column = $locale == 'en' ? 'alt' : 'alt_fi'}
<section id="gallery" class="flex flex-row flex-wrap w-full">
<figure n:foreach="$images as $image">
    {var $filepath = $uploadDir . '/' . $image->filename}
    <a n:href="edit $image->id"><img n:class="$image->$alt_column == null ? border-error, border-2, w-96, m-4, p-2" src={$filepath} alt={$image->$alt_column ?? $image->filename} width={$image->width} height={$image->height}></a>
    <button id=btn_en_{$image->id} class="btn btn-primary" onclick="mdImgCopy({$filepath}, {$image->alt ?? $image->filename}, btn_en_{$image->id})">{svgIcon 'fill/svg/copy.svg', class: 'fill-current stroke-current w-8 h-8'}{_g.media.copyMDEnglishAlt}</button>
    <button id=btn_fi_{$image->id} class="btn btn-primary" onclick="mdImgCopy({$filepath}, {$image->alt_fi ?? $image->filename}, btn_fi_{$image->id})">{svgIcon 'fill/svg/copy.svg', class: 'fill-current stroke-current w-8 h-8'}{_g.media.copyMDFinnishAlt}</button>
</figure>
</section>
{/block}
{block scripts}
<script n:syntax="double">
function mdImgCopy(src, alt, button) {
    const text = `![${alt}](${src} "${alt}")`;
    navigator.clipboard.writeText(text);
    button.textContent = {{_g.media.copiedToClipboard}};
    button.disabled = true; 
}
</script>