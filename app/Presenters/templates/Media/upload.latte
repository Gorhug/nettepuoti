{block content}
<div class="flex-col">

    <h1 class="text-5xl font-semibold font-[Raleway]" n:block="title">{_g.upload.title}</h1>


    <div class="m-8">{_g.upload.explain, [formats => $formats]} {_g.upload.fileSize, [size => ($maxFileSize | bytes)]}</div>

    <div class="card shrink-0 w-full max-w-sm shadow-2xl bg-base-100 mx-8">
        {embed basic-form, form: uploadForm}{/embed}
    </div>
</div>
