{block content}
<div class="flex-col">
<div class="text-center mb-4">
    <h1 class="text-5xl font-bold" n:block="title">{_g.upload.title}</h1>
</div>

<div class="my-8">{_g.upload.explain, [formats => $formats]} {_g.upload.fileSize, [size => ($maxFileSize | bytes)]}</div>

<div class="card shrink-0 w-full max-w-sm shadow-2xl bg-base-100">
{embed basic-form, form: uploadForm}
{/embed}
</div>
</div>
