{block content}
<div class="flex-col hero-content">
<div class="mb-4">
    <h1 class="text-5xl font-semibold font-[Raleway]" n:block="title">{_g.feedback.title}</h1>
</div>

<div class="my-8">{_g.feedback.explain}</div>

<div class="card shrink-0 w-full max-w-sm shadow-2xl bg-base-100">
{embed basic-form, form: contactForm}
{/embed}
</div>
</div>
