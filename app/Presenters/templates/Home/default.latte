{block content}
{cache $locale, tags: [home]}
<div class="hero-content">
<div class="max-w-md">
      {define title}{_g.home}{/define}

{* <span class="bg-clip-text font-serif text-transparent box-decoration-clone bg-linear-to-br from-primary via-accent to-secondary text-center text-5xl sm:text-9xl h-48">gorhug.fi</span> *}
<div class="prose mt-24 {$proseFonts}">

{block|parsedown}
{_g.welcome}
{/block}
</div>
	{* <button 
            class="btn btn-primary btn-disabled"
        >
            Clicks: disabled
    </button> *}

	{* <h1>Items for sale</h1> *}
	<div class="card bg-base-100 shadow-xl my-4" n:foreach="$products as $product">
		<a n:href="Product:show $product->id">
			<section class="card-body hover:text-primary">
				<span class="card-title font-[Raleway] font-semibold link link-primary">{$product->name}</span>
				<div class="text-left font-semibold">{$product->created_at|localDate: date: full}</div>
				{* <details class="text-justify hyphens-auto"> *}
					<section class="font-medium">{$product->brief}</section>
					{* <div class="prose {$proseFonts}" hx-disable>{block|trim|parsedown}{$product->description}{/block}</div> *}
				{* </details> *}
				{* <div class="card-actions justify-end">
					<a n:href="Product:show $product->id" class="btn btn-primary btn-outline">{_g.readMore}</a>
				</div> *}
			</section>
		</a>
	</div>
</div>
</div>
{/cache}