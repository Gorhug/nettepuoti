{define basic-form, $form}
{var $testing=false}
<form n:name=$form class="ajax">
	{* List for form-level error messages *}
	<ul class="alert alert-error" n:ifcontent>
		<li n:foreach="$form->ownErrors as $error">{$error}</li>
	</ul>

	<fieldset n:foreach="$form->getGroups() as $group">
		{include controls $group->getControls()}
	</fieldset>

	{include controls $form->getControls()}

	<button n:if="$testing" formnovalidate class="btn btn-warning">Server validation test</button>

</form>

{* <script src="{='src/js/liveform.js'|asset}" type="module"></script> *}

{define controls array $controls}
	{* Loop over form controls and render each one *}
	<div n:foreach="$controls as $control"
		n:if="!$control->getOption(rendered) && $control->getOption(type) !== hidden"
		n:class="mb-3, row, form-control, $control->required ? required">

		{* Label for the control *}
		<div class="col-sm-3 mb-2 label">{label $control /}</div>

		<div class="col-sm-9 form-control">
			{include control $control}
			{if $control->getOption(type) === button}
				{while $iterator->nextValue?->getOption(type) === button}
					{input $iterator->nextValue class => "btn btn-secondary"}
					{do $iterator->next()}
				{/while}
			{/if}

			{* Display control-level errors or descriptions, if present *}
			<span class=text-error n:ifcontent>{$control->error}</span>
			<span class=text-info n:ifcontent>{$control->getOption(description)}</span>
		</div>
	</div>
{/define}


{define control Nette\Forms\Controls\BaseControl $control}
	{* Conditionally render controls based on their type with appropriate DaisyUI classes *}
	{switch $control->getOption(type)}
	{case text, select, datetime}
		{input $control class => "input validator", placeholder: ''}

	{case file}
		{input $control class => "file-input"}
		
	{case textarea}
		{var $parse = $control->getOption(markdown)}
		{var $in_lang = str_ends_with($control->name, "fi") ? 'fi' : 'en'}
		{var $ta_class = "input validator text-wrap"}
		<div class="flex flex-col md:flex-row">
		{if $parse}
			<div class="indicator mt-4">
				<span class="indicator-item indicator-center badge">{_g.form.mdEditor}</span>
				{input $control class => "{$ta_class} w-auto sm:w-96 h-96 pt-2", placeholder: '', wrap: 'soft',
					hx-get: $presenter->link('preview'),
					hx-trigger: "keyup changed delay:900ms",
					hx-target: "#preview-{$control->name}",
					hx-indicator: "#indicator-{$control->name}",
					lang: $in_lang
				}
			</div>
			<div class="relative indicator mt-4">
				<span class="indicator-item indicator-center badge">{_g.form.mdPreview}</span>
				<span id="indicator-{$control->name}" class="loading loading-bars text-primary loading-xl absolute top-2/4 left-2/4 htmx-indicator"></span>
				<div id="preview-{$control->name}" class="prose h-96 w-auto sm:w-96 p-2 overflow-scroll border-accent border-2 text-justify hyphens-auto" lang={$in_lang} hx-disable>
					{block|trim|parsedown}{$control->getValue()}{/block}
				</div>
			</div>
		{else}
			{input $control class => "{$ta_class} w-full h-32", placeholder: '', wrap: 'soft', lang: $in_lang}
		{/if}
		</div>
	{case button}
		{input $control class => "btn btn-primary"}

	{case checkbox, radio}
		{var $items = $control instanceof Nette\Forms\Controls\Checkbox ? [''] : $control->getItems()}
		<div n:foreach="$items as $key => $foo" class="form-control">
			<div class="label">
			{label $control:$key class => "label-text cursor-pointer" /}
			{input $control:$key class => "checkbox checkbox-primary"}
			</div>
		</div>

	{case color}
		{input $control class => "form-control form-control-color"}

	{default}
		{input $control}
	{/switch}
{/define}

{/define}
