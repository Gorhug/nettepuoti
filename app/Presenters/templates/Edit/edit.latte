<div class="flex-col space-y-4 max-w-3xl mt-8">
    <div class="mb-4">
        <h1 class="text-4xl font-bold" n:block="title">{_g.edit.editTitle}</h1>
    </div>
    {include 'help.latte'}


    <div class="card shrink-0 w-full shadow-2xl bg-base-100">
        {embed basic-form, form: productForm}{/embed}
    </div>
</div>
